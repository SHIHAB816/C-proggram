

#include <stdio.h>

int main() {
    int n;
    printf("Enter rows: ");
    if (scanf("%d", &n) != 1) return 0;
    // Find last number
    int last = n*(n+1)/2;
    for (int i = n; i >= 1; i--) {
        for (int j = 0; j < i; j++) {
            printf("%d ", last - (i - 1 - j));
        }
        last -= i;
        printf("\n");
    }
    return 0;
}
