#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int index;
    printf("Enter a string: ");
    gets(str);
    printf("Enter index: ");
    scanf("%d", &index);
    
    if(index >= 0 && index < strlen(str)) {
        printf("Unicode code point at index %d is %d\n", index, (unsigned char)str[index]);
    } else {
        printf("Index out of range.\n");
    }
    return 0;
}
