#include <stdio.h>
#include <math.h>

int main() {
    double a, b, c, disc, r1, r2, realPart, imagPart;
    printf("Enter coefficients a b c: ");
    if (scanf("%lf %lf %lf", &a, &b, &c) != 3) return 0;
    if (a == 0) { printf("Not a quadratic equation.\n"); return 0; }
    disc = b*b - 4*a*c;
    if (disc > 0) {
        r1 = (-b + sqrt(disc)) / (2*a);
        r2 = (-b - sqrt(disc)) / (2*a);
        printf("Roots: %.6f and %.6f\n", r1, r2);
    } else if (disc == 0) {
        r1 = -b / (2*a);
        printf("Double root: %.6f\n", r1);
    } else {
        realPart = -b / (2*a);
        imagPart = sqrt(-disc) / (2*a);
        printf("Roots: %.6f + %.6fi and %.6f - %.6fi\n", realPart, imagPart, realPart, imagPart);
    }
    return 0;
}
