#include <stdio.h>
#include <math.h>
#include <stdbool.h>

bool isPrime(int x) {
    if (x <= 1) return false;
    if (x <= 3) return true;
    if (x % 2 == 0) return false;
    for (int i = 3; i <= (int)sqrt(x); i += 2)
        if (x % i == 0) return false;
    return true;
}

int main() {
    int n;
    printf("Enter number: ");
    if (scanf("%d", &n) != 1) return 0;
    if (isPrime(n)) printf("%d is prime\n", n);
    else printf("%d is not prime\n", n);
    return 0;
}
