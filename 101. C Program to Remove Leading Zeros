#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int i = 0;
    printf("Enter a string: ");
    gets(str);
    
    while(str[i] == '0') {
        i++;
    }
    
    if(i == strlen(str))
        printf("0\n");
    else
        printf("String after removing leading zeros: %s\n", &str[i]);
    
    return 0;
}
