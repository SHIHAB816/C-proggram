
#include <stdio.h>

int main() {
    int n;

    printf("Enter array size: ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Invalid array size\n");
        return 0;
    }

    int arr[n];

    printf("Enter array elements: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    int largest = arr[0];
    int secondLargest = 0;
    int found = 0;

    for (int i = 1; i < n; i++) {

        if (arr[i] > largest) {
            secondLargest = largest;
            largest = arr[i];
            found = 1;
        }
        else if (arr[i] < largest) {
            if (found == 0 || arr[i] > secondLargest) {
                secondLargest = arr[i];
                found = 1;
            }
        }
    }

    if (found == 1) {
        printf("Second largest unique element: %d\n",
               secondLargest);
    }
    else {
        printf("Not possible\n");
    }

    return 0;
}
