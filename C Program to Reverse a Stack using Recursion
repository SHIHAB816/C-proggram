#include <stdio.h>
#include <stdlib.h>

void insertAtBottom(int stack[], int *top, int val) {
    if (*top == -1) {
        stack[++(*top)] = val;
        return;
    }
    int temp = stack[(*top)--];
    insertAtBottom(stack, top, val);
    stack[++(*top)] = temp;
}

void reverseStack(int stack[], int *top) {
    if (*top == -1) return;
    int temp = stack[(*top)--];
    reverseStack(stack, top);
    insertAtBottom(stack, top, temp);
}

int main() {
    int n;
    printf("Enter number of elements: ");
    if (scanf("%d", &n) != 1 || n <= 0) return 0;
    int *stack = (int*)malloc(n * sizeof(int));
    int top = -1;
    printf("Enter elements (top will be last entered):\n");
    for (int i = 0; i < n; i++) {
        int x; scanf("%d", &x);
        stack[++top] = x;
    }
    reverseStack(stack, &top);
    printf("Stack after reversal (top to bottom):\n");
    for (int i = top; i >= 0; i--) printf("%d\n", stack[i]);
    free(stack);
    return 0;
}
