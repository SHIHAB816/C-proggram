#include <stdio.h>
int main(){
    int a[3][3], b[3][3], i, j;
    printf("Enter 3x3 matrix:\n");
    for(i=0;i<3;i++)
        for(j=0;j<3;j++)
            scanf("%d", &a[i][j]);
    for(i=0;i<3;i++)
        for(j=0;j<3;j++)
            b[j][2-i] = a[i][j]; // rotate clockwise
    printf("Rotated Matrix:\n");
    for(i=0;i<3;i++){
        for(j=0;j<3;j++)
            printf("%d ", b[i][j]);
        printf("\n");
    }
    return 0;
}
