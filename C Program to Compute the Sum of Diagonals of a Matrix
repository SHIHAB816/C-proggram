#include <stdio.h>
int main(){
    int a[10][10], i, j, n, sum=0;
    printf("Enter matrix size: ");
    scanf("%d", &n);
    printf("Enter matrix elements:\n");
    for(i=0;i<n;i++)
        for(j=0;j<n;j++)
            scanf("%d", &a[i][j]);
    for(i=0;i<n;i++){
        sum += a[i][i];
        if(i != n-i-1)
            sum += a[i][n-i-1];
    }
    printf("Sum of diagonals = %d\n", sum);
    return 0;
}
