#include <stdio.h>
int main(){
    int a[10][10], i, j, r, c, temp;
    printf("Enter rows and columns: ");
    scanf("%d %d", &r, &c);
    printf("Enter matrix:\n");
    for(i=0;i<r;i++)
        for(j=0;j<c;j++)
            scanf("%d", &a[i][j]);
    for(i=0;i<r;i++){
        temp = a[i][0];
        a[i][0] = a[i][c-1];
        a[i][c-1] = temp;
    }
    printf("Matrix after interchange:\n");
    for(i=0;i<r;i++){
        for(j=0;j<c;j++)
            printf("%d ", a[i][j]);
        printf("\n");
    }
    return 0;
}
