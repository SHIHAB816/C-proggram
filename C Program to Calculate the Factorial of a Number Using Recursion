#include <stdio.h>

long long fact(int n) {
    if (n <= 1) return 1;
    return n * fact(n - 1);
}

int main() {
    int n;
    printf("Enter n (>=0): ");
    if (scanf("%d", &n) != 1) return 0;
    if (n < 0) { printf("Invalid input.\n"); return 0; }
    printf("Factorial of %d = %lld\n", n, fact(n));
    return 0;
}
