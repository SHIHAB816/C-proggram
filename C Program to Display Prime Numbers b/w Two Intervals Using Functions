#include <stdio.h>
#include <math.h>
#include <stdbool.h>

bool isPrime(int x) {
    if (x <= 1) return false;
    if (x <= 3) return true;
    if (x % 2 == 0) return false;
    for (int i = 3; i <= (int)sqrt(x); i += 2)
        if (x % i == 0) return false;
    return true;
}

int main() {
    int a, b;
    printf("Enter lower and upper bound: ");
    if (scanf("%d %d", &a, &b) != 2) return 0;
    if (a > b) { int t = a; a = b; b = t; }
    printf("Primes between %d and %d:\n", a, b);
    for (int i = a; i <= b; i++)
        if (isPrime(i)) printf("%d ", i);
    printf("\n");
    return 0;
}
