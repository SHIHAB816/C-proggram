#include <stdio.h>

int main() {
    int n, i, j, sp;
    printf("Enter half-diamond rows: ");
    if (scanf("%d", &n) != 1) return 0;
    // upper hollow pyramid
    for (i = 1; i <= n; i++) {
        for (j = 0; j < n - i; j++) printf(" ");
        if (i == 1) { printf("*\n"); continue; }
        printf("*");
        for (sp = 0; sp < 2*i-3; sp++) printf(" ");
        printf("*\n");
    }
    // lower hollow inverted pyramid (exclude middle row)
    for (i = n-1; i >= 1; i--) {
        for (j = 0; j < n - i; j++) printf(" ");
        if (i == 1) { printf("*\n"); continue; }
        printf("*");
        for (sp = 0; sp < 2*i-3; sp++) printf(" ");
        printf("*\n");
    }
    return 0;
}
