#include <stdio.h>
#include <math.h>
#include <stdbool.h>

bool isPrime(int x) {
    if (x <= 1) return false;
    if (x <= 3) return true;
    if (x % 2 == 0) return false;
    for (int i = 3; i <= (int)sqrt(x); i += 2)
        if (x % i == 0) return false;
    return true;
}

int main() {
    int n;
    printf("Enter a number: ");
    if (scanf("%d", &n) != 1) return 0;
    int found = 0;
    for (int i = 2; i <= n/2; i++) {
        if (isPrime(i) && isPrime(n - i)) {
            printf("%d = %d + %d\n", n, i, n - i);
            found = 1;
            break;
        }
    }
    if (!found) printf("No representation as sum of two primes found.\n");
    return 0;
}
